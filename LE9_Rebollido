#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    int n, age;
    char name[100], course[100];
    char line[200];

    printf("How many student records do you want to enter? ");
    scanf("%d", &n);
    getchar();

    fp = fopen("student_records.txt", "w");

    if (fp == NULL) {
        printf("Error opening file!");
        return 1;
    }

    for (int i = 1; i <= n; i++) {
        printf("\nStudent %d\n", i);

        printf("Enter Name: ");
        fgets(name, sizeof(name), stdin);
        name[strcspn(name, "\n")] = '\0';

        printf("Enter Age: ");
        scanf("%d", &age);
        getchar();

        printf("Enter Course: ");
        fgets(course, sizeof(course), stdin);
        course[strcspn(course, "\n")] = '\0';

        fprintf(fp, "Student %d\n", i);
        fprintf(fp, "Name: %s\n", name);
        fprintf(fp, "Age: %d\n", age);
        fprintf(fp, "Course: %s\n", course);
        fprintf(fp, "----------------------\n");
    }

    fclose(fp);

    fp = fopen("student_records.txt", "r");

    if (fp == NULL) {
        printf("Error reading file!");
        return 1;
    }

    printf("\nStudent Records:\n\n");

    while (fgets(line, sizeof(line), fp) != NULL) {
        printf("%s", line);
    }

    fclose(fp);

    return 0;
}
